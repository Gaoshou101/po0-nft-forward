#!/usr/bin/env bash
# Mock ip(8): private-IP enumeration + default route lookup used by po0-forward.sh
if [[ "$*" == *"addr show"* ]]; then
  cat <<'EOF'
1: lo    inet 127.0.0.1/8 scope host lo
2: eth0    inet 203.0.113.10/24 brd 203.0.113.255 scope global eth0
3: eth1    inet 10.100.0.10/24 brd 10.100.0.255 scope global eth1
4: eth2    inet 10.0.0.5/24 brd 10.0.0.255 scope global eth2
EOF
  exit 0
fi
if [[ "$*" == *"route get"* ]]; then
  echo "1.1.1.1 via 203.0.113.1 dev eth0 src 203.0.113.10 uid 0"
  echo "    cache"
  exit 0
fi
exit 0
